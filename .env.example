# Cloudflare Worker URL for Windows XP Portfolio (Optional)
# If left empty, the portfolio runs smoothly in local fallback mode using browser storage and embedded defaults.
VITE_CLOUDFLARE_API_URL=https://portfolio-api.your-subdomain.workers.dev

# AI Copilot Keys for Admin Panel (Optional - can also be set directly in Admin.exe UI)
# OpenRouter API key (supports 100+ models including free models like Gemini 2.0 / Llama 3.3)
VITE_OPENROUTER_API_KEY=
# Google Gemini API key (free tier available at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=
# OpenAI API key (requires OpenAI billing credits)
VITE_OPENAI_API_KEY=
# Groq API key (optional alternative)
VITE_GROQ_API_KEY=
